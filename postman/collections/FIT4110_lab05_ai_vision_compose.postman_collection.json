              "raw": "{\n  \"requestId\": \"REQ-CAM-20260512-0005\",\n  \"cameraId\": \"CAM-ER-01\",\n  \"capturedAt\": \"2026-05-12T08:00:00Z\",\n  \"traceId\": \"TRACE-20260512-0005\",\n  \"motionLevel\": 1.2,\n  \"imageSource\": {\n    \"sourceType\": \"IMAGE_URL\",\n    \"url\": \"https://media.hospital.local/camera/CAM-ER-01/frame-1005.jpg\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid motionLevel returns 422', function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
